{
	servers {
		trusted_proxies static private_ranges
	}
}

(security) {
	header {
		Strict-Transport-Security "max-age=86400"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

yinglong-agent.tech {
	import security
	redir https://app.yinglong-agent.tech{uri} 302
}

app.yinglong-agent.tech {
	import security
	header X-Frame-Options "DENY"
	encode zstd gzip
	# The web app (Next.js) on 127.0.0.1:3000; while it is not running, serve the static placeholder.
	reverse_proxy 127.0.0.1:3000
	handle_errors 502 503 {
		root * /srv/app
		rewrite * /index.html
		file_server {
			status 200
		}
	}
}

api.yinglong-agent.tech {
	import security
	encode zstd gzip
	handle /v1/* {
		reverse_proxy 127.0.0.1:8787
	}
	@services path /fx/* /kyb/* /mirage/* /.well-known/* /agents/*
	handle @services {
		reverse_proxy 127.0.0.1:8790
	}
	@indexer path /proof/* /rpc/fisco
	handle @indexer {
		reverse_proxy 127.0.0.1:8791
	}
	handle /healthz {
		header Content-Type "application/json"
		respond `{"status":"ok","service":"yinglong-api"}` 200
	}
	handle {
		header Content-Type "application/json"
		respond `{"error":"not_found"}` 404
	}
}
