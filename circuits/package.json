{
  "name": "@yinglong/circuits",
  "version": "0.1.0",
  "private": true,
  "description": "YINGLONG zero-knowledge circuits: private mandate compliance prover (Noir + UltraHonk, keccak oracle)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
