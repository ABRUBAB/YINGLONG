    "typecheck": "tsc -p prover/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aztec/bb.js": "5.2.1",
    "@noir-lang/noir_js": "1.0.0-rc.5",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
